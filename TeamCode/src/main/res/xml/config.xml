<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <EthernetDevice name="Webcam Turret" serialNumber="EthernetOverUsb:eth0:172.29.0.22"  port="0" ipAddress="172.29.0.1" />
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <goBILDA5202SeriesMotor name="turretUp" port="0" /> <!-- Flywheel Encoder -->
            <goBILDA5202SeriesMotor name="turretDown" port="1" />
            <goBILDA5202SeriesMotor name="backRight" port="2" />
            <goBILDA5202SeriesMotor name="frontRight" port="3" />

            <ContinuousRotationServo name = "dexLeft" port = "0" />
            <Servo name="flapperRight" port="4"/>

            <RevColorSensorV3 name="rotaryColorSensorF" port="0" bus="3"/>
            <LynxColorSensor name="rotaryColorSensorL" port="0" bus="2"/>

            <Servo name="leftHood" port="2"/>
            <Servo name="rightHood" port="3"/>

            <goBILDAPinpoint name="pinpoint" port="1"/>
            <LynxEmbeddedIMU name="imu" port="0" bus="0" />
        </LynxModule>
    </LynxUsbDevice>
    <LynxUsbDevice name="Expansion Hub Portal 1" serialNumber="DQ8P04TT" parentModuleAddress="1">
        <LynxModule name="Expansion Hub 2" port="2">
            <goBILDA5202SeriesMotor name="turretRotate" port="0" />
            <goBILDA5202SeriesMotor name="backLeft" port="1" />
            <goBILDA5202SeriesMotor name="intakeMotor" port="2" /> <!-- Spindex Encoder-->
            <goBILDA5202SeriesMotor name="frontLeft" port="3" />

            <ContinuousRotationServo name="dexRight" port="0"/>

            <Servo name="flapperLeft" port="4"/>

            <LynxColorSensor name="rotaryColorSensorR" port="0" bus="3"/>
        </LynxModule>
    </LynxUsbDevice>
</Robot>
